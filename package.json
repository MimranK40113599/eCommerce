{
  "name": "shopit-ecommerce",
  "version": "1.0.0",
  "description": "ShopIT - Full Stack E-Commerce Application",
  "type": "module",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "nodemon backend/app.js",
    "seed": "node backend/seeder/seeder.js",
    "seed:clear": "node backend/seeder/seeder.js --clear",
    "seed:update": "node backend/seeder/seeder.js --update",
    "seed:dry": "node backend/seeder/seeder.js --dry-run",
    "seed:prod": "NODE_ENV=production node backend/seeder/seeder.js --clear",
    "seed:export": "node backend/seeder/seeder-cli.js export",
    "seed:import": "node backend/seeder/seeder-cli.js import"
  },
  "keywords": [
    "ecommerce",
    "shopit",
    "mern",
    "mongodb",
    "express",
    "react",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MimranK40113599/eCommerce.git"
  },
  "bugs": {
    "url": "https://github.com/MimranK40113599/eCommerce/issues"
  },
  "homepage": "https://github.com/MimranK40113599/eCommerce#readme",
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "email-validator": "^2.0.4",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "limiter": "^3.0.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.5",
    "stripe": "^14.24.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "inquirer": "^9.2.11",
    "nodemon": "^3.0.1"
  }
